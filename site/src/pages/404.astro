---
import Base from "../layouts/Base.astro";
import { url } from "../lib/data";
---

<Base title="404">
  <div class="py-16 text-center">
    <h1 class="text-3xl font-bold">404</h1>
    <p class="mt-2 text-stone-600 dark:text-stone-400">මෙම පිටුව හමු නොවීය. · Page not found.</p>
    <a class="mt-6 inline-block rounded-full bg-stone-900 px-4 py-2 text-white dark:bg-stone-100 dark:text-stone-900" href={url()}>
      මුල් පිටුවට · Home
    </a>
  </div>
</Base>
