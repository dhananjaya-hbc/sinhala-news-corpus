---
import HeadlineList from "../../components/HeadlineList.astro";
import Base from "../../layouts/Base.astro";
import { CATEGORIES, CATEGORY_IDS, data, type CategoryId } from "../../lib/data";

export function getStaticPaths() {
  return CATEGORY_IDS.map((id) => ({ params: { id } }));
}

const id = Astro.params.id as CategoryId;
const category = CATEGORIES[id];
const headlines = data.headlines.filter((h) => h.c === id);
---

<Base title={category.si} active={id} description={`Latest Sinhala ${category.en.toLowerCase()} news headlines from Sri Lankan publishers.`}>
  <header class="mb-6">
    <h1 class="text-2xl font-bold">{category.si} <span class="text-lg font-normal text-stone-500">· {category.en}</span></h1>
    <p class="text-sm text-stone-500 dark:text-stone-400">
      පසුගිය දින {data.days} තුළ සිරස්තල {headlines.length} · {headlines.length} headlines in the last {data.days} days
    </p>
  </header>
  <HeadlineList headlines={headlines} showCategory={false} />
</Base>
