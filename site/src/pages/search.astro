---
import Base from "../layouts/Base.astro";
import { CATEGORIES, CATEGORY_IDS, SECTION_ORDER, data, url } from "../lib/data";

const categoryNames = Object.fromEntries(CATEGORY_IDS.map((id) => [id, CATEGORIES[id].si]));
const sourceNames = Object.fromEntries(data.sources.map((s) => [s.id, s.name]));
const filters = [...SECTION_ORDER, "other" as const];
const pill = "border px-3 py-1 text-sm transition-colors";
---

<Base title="සොයන්න" active="search" compact description="Search recent Sinhala news headlines.">
  <header class="mb-6 text-center">
    <p class="text-sm text-ink-3">— <span class="font-sans text-xs uppercase italic tracking-[0.3em]">Archive search</span> · <span class="font-bold">ලේඛනාගාරය</span> —</p>
    <h1 class="mt-1 font-serif text-[3rem] font-extrabold leading-[1.1] sm:text-[3.8rem]">සොයන්න</h1>
    <p class="mt-1 text-sm text-ink-2">පසුගිය දින {data.days} තුළ සිරස්තල {data.headlines.length}ක් අතර සොයන්න.</p>
  </header>

  <form id="search-form" role="search" onsubmit="return false" class="mb-8">
    <label class="sr-only" for="q">Search headlines</label>
    <input
      id="q"
      type="search"
      autocomplete="off"
      placeholder="ක්‍රිකට්, IMF, ශ්‍රී ලංකා…"
      class="w-full rounded-none border-0 border-y-2 border-ink bg-transparent px-1 py-3 text-center font-serif text-[1.9rem] text-ink placeholder:text-ink-3 focus:bg-paper-2 focus:outline-none focus-visible:outline-none sm:text-[2.4rem]"
    />
    <div class="mt-4 flex flex-wrap justify-center gap-2" role="group" aria-label="Filter by section">
      <button type="button" data-cat="" aria-pressed="true" class:list={[pill, "border-ink bg-ink text-paper"]}>සියල්ල</button>
      {
        filters.map((id) => (
          <button type="button" data-cat={id} aria-pressed="false" class:list={[pill, "border-ink text-ink hover:bg-paper-2"]}>
            {CATEGORIES[id].si}
          </button>
        ))
      }
    </div>
  </form>

  <p id="status" class="mb-4 border-b border-ink pb-2 text-center text-sm text-ink-2" aria-live="polite"></p>
  <div
    id="results"
    class="news-columns md:columns-2 lg:columns-3"
    data-index={url("search.json")}
    data-base={url()}
    data-categories={JSON.stringify(categoryNames)}
    data-sources={JSON.stringify(sourceNames)}
  >
  </div>
</Base>

<script>
  interface Hit {
    d: string;
    s: string;
    c: string;
    h: string;
    u: string;
  }

  const MAX_RESULTS = 120;
  const ACTIVE = ["border-ink", "bg-ink", "text-paper"];
  const IDLE = ["border-ink", "text-ink", "hover:bg-paper-2"];

  const results = document.getElementById("results") as HTMLDivElement;
  const input = document.getElementById("q") as HTMLInputElement;
  const status = document.getElementById("status") as HTMLParagraphElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("button[data-cat]")];
  const base = results.dataset.base ?? "/";
  const categories = JSON.parse(results.dataset.categories ?? "{}") as Record<string, string>;
  const sources = JSON.parse(results.dataset.sources ?? "{}") as Record<string, string>;
  let category = "";
  // Spelled out here because some browsers ship without Sinhala date formatting
  const MONTHS = ["ජනවාරි", "පෙබරවාරි", "මාර්තු", "අප්‍රේල්", "මැයි", "ජූනි", "ජූලි", "අගෝස්තු", "සැප්තැම්බර්", "ඔක්තෝබර්", "නොවැම්බර්", "දෙසැම්බර්"];
  const sinhalaDate = (iso: string) => {
    const [year, month, day] = iso.split("-").map(Number);
    return `${year} ${MONTHS[month - 1]} ${day}`;
  };

  // Match the way the corpus is cleaned: NFC, no zero-width characters, case-folded.
  // So "ශ්රී" (typed without ZWJ) still finds "ශ්‍රී".
  const normalize = (text: string) =>
    text.normalize("NFC").replace(/[​-‍⁠﻿]/g, "").toLowerCase().replace(/\s+/g, " ").trim();

  let index: { hit: Hit; key: string }[] = [];

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function story(hit: Hit) {
    const wrap = el("div", "story-dash pb-4 text-center");
    const kicker = el("a", "mb-0.5 inline-block text-[0.8rem] font-bold text-ink-2 hover:underline", categories[hit.c] ?? hit.c);
    kicker.href = `${base}category/${hit.c}/`;
    const h3 = el("h3", "font-serif text-[1.15rem] font-bold leading-[1.48] text-ink");
    const link = el("a", "headline-link", hit.h);
    link.href = hit.u;
    link.target = "_blank";
    link.rel = "noopener";
    h3.append(link);
    const meta = el("p", "mt-1 flex flex-wrap items-center justify-center gap-x-2 text-[0.78rem] text-ink-3");
    const source = el("a", "font-sans uppercase tracking-[0.12em] hover:text-ink", sources[hit.s] ?? hit.s);
    source.href = `${base}source/${hit.s}/`;
    const time = el("time", "", sinhalaDate(hit.d));
    time.dateTime = hit.d;
    meta.append(source, el("span", "", "·"), time);
    wrap.append(kicker, h3, meta);
    return wrap;
  }

  function render() {
    const terms = normalize(input.value).split(" ").filter(Boolean);
    results.replaceChildren();
    if (!terms.length && !category) {
      status.textContent = "සෙවීමට වචනයක් ටයිප් කරන්න, නැතහොත් අංශයක් තෝරන්න. · Type a word or pick a section.";
      return;
    }
    const matches = index.filter(({ hit, key }) => (!category || hit.c === category) && terms.every((t) => key.includes(t)));
    status.textContent = matches.length
      ? `ප්‍රතිඵල ${matches.length}${matches.length > MAX_RESULTS ? ` · පළමු ${MAX_RESULTS} පෙන්වයි` : ""}`
      : "ප්‍රතිඵල නැත. · No results.";
    results.append(...matches.slice(0, MAX_RESULTS).map(({ hit }) => story(hit)));
  }

  function selectCategory(value: string) {
    category = value;
    for (const button of buttons) {
      const on = button.dataset.cat === value;
      button.setAttribute("aria-pressed", String(on));
      button.classList.remove(...(on ? IDLE : ACTIVE));
      button.classList.add(...(on ? ACTIVE : IDLE));
    }
    render();
  }

  let timer: number | undefined;
  const schedule = () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(render, 120);
  };

  status.textContent = "සිරස්තල පූරණය වෙමින්… · Loading…";
  fetch(results.dataset.index ?? "search.json")
    .then((response) => response.json() as Promise<Hit[]>)
    .then((hits) => {
      index = hits.map((hit) => ({ hit, key: normalize(hit.h) }));
      const params = new URLSearchParams(location.search);
      input.value = params.get("q") ?? "";
      input.addEventListener("input", schedule);
      for (const button of buttons) button.addEventListener("click", () => selectCategory(button.dataset.cat ?? ""));
      selectCategory(params.get("c") ?? "");
      input.focus();
    })
    .catch(() => {
      status.textContent = "සෙවුම් දත්ත පූරණය කළ නොහැක. · Could not load search data.";
    });
</script>
