---
import Label from "../components/Label.astro";
import Story from "../components/Story.astro";
import Base from "../layouts/Base.astro";
import { CATEGORIES, SECTION_ORDER, countBy, data, formatDate, frontPage, url } from "../lib/data";

const { lead, also, sections, latestDay, latestCount } = frontPage();
const nf = new Intl.NumberFormat("en-US");

// Topic mix over the last 30 days, drawn as thin printed-style bars
const topicCounts = countBy(data.headlines, (h) => h.c);
const topics = SECTION_ORDER.map((id) => ({ id, n: topicCounts.get(id) ?? 0 })).filter((t) => t.n > 0);
const maxTopic = Math.max(1, ...topics.map((t) => t.n));
const sourceCounts = countBy(data.headlines, (h) => h.s);
const publishers = data.sources.map((s) => ({ ...s, recent: sourceCounts.get(s.id) ?? 0 })).sort((a, b) => b.recent - a.recent);
---

<Base title="සිංහල පුවත්" active="home">
  <h1 class="sr-only">සිංහල පුවත් සිරස්තල · Today's Sinhala news headlines</h1>

  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-12">
    <!-- Lead and today's stories -->
    <div class="min-w-0">
      {
        lead && (
          <section class="border-b-2 border-ink pb-8" aria-label="Lead story">
            <Label si="ප්‍රධාන පුවත" en="Lead story" class="mb-3" />
            <Story h={lead} size="lead" date />
          </section>
        )
      }

      {
        also.length > 0 && (
          <section class="pt-6" aria-label="Also today">
            <Label as="h2" si="අද තවත් පුවත්" en="Also today" class="mb-1" />
            <div class="news-columns sm:columns-2">
              {also.map((h) => (
                <div class="border-b border-rule py-4">
                  <Story h={h} size="md" />
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <!-- Rail: the numbers behind this edition -->
    <aside class="space-y-8 lg:border-l lg:border-rule lg:pl-10" aria-label="This edition">
      <section class="border-t-2 border-ink pt-3">
        <Label as="h2" si="මෙම කලාපය" en="This edition" />
        <dl class="mt-4 grid grid-cols-3 gap-3 lg:grid-cols-1 lg:gap-5">
          <div class="flex flex-col-reverse">
            <dt class="mt-1 text-xs text-ink-2">{latestDay ? formatDate(latestDay) : ""} සිරස්තල</dt>
            <dd class="font-serif text-4xl font-extrabold leading-none tabular-nums">{nf.format(latestCount)}</dd>
          </div>
          <div class="flex flex-col-reverse">
            <dt class="mt-1 text-xs text-ink-2">පසුගිය දින {data.days}</dt>
            <dd class="font-serif text-4xl font-extrabold leading-none tabular-nums">{nf.format(data.headlines.length)}</dd>
          </div>
          <div class="flex flex-col-reverse">
            <dt class="mt-1 text-xs text-ink-2">මුළු දත්ත කට්ටලය · all-time</dt>
            <dd class="font-serif text-4xl font-extrabold leading-none tabular-nums">{nf.format(data.total_all_time)}</dd>
          </div>
        </dl>
      </section>

      <section class="border-t-2 border-ink pt-3">
        <Label as="h2" si="මාතෘකා" en="Topics, 30 days" />
        <ul class="mt-3 space-y-2">
          {
            topics.map((t) => (
              <li>
                <a href={url(`category/${t.id}/`)} class="group grid grid-cols-[5.5rem_1fr_2.25rem] items-center gap-3 text-sm">
                  <span class="group-hover:text-accent">{CATEGORIES[t.id].si}</span>
                  <span class="h-[7px] bg-paper-2" aria-hidden="true">
                    <span class="block h-full bg-ink group-hover:bg-accent" style={`width:${(100 * t.n) / maxTopic}%`} />
                  </span>
                  <span class="text-right tabular-nums text-ink-2">{t.n}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="border-t-2 border-ink pt-3">
        <Label as="h2" si="ප්‍රකාශකයන්" en="Publishers" />
        <ul class="mt-2 divide-y divide-rule text-sm">
          {
            publishers.map((s) => (
              <li class="flex items-baseline justify-between gap-3 py-1.5">
                <a href={url(`source/${s.id}/`)} class="hover:text-accent">{s.name}</a>
                <span class="tabular-nums text-ink-3">{s.recent}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>
  </div>

  <!-- Sections, flowing in ruled newspaper columns -->
  <div class="mt-12 border-t-[3px] border-double border-ink pt-8">
    <div class="news-columns md:columns-2 lg:columns-3">
      {
        sections.map((s) => (
          <section class="mb-10" aria-labelledby={`sec-${s.id}`}>
            <header class="flex items-baseline justify-between gap-3 border-b-2 border-ink pb-1.5">
              <h2 id={`sec-${s.id}`} class="font-serif text-[1.75rem] font-extrabold leading-tight">
                <a href={url(`category/${s.id}/`)} class="hover:text-accent">{CATEGORIES[s.id].si}</a>
              </h2>
              <a href={url(`category/${s.id}/`)} class="shrink-0 font-sans text-[0.66rem] font-medium uppercase tracking-[0.2em] text-ink-3 hover:text-accent">
                {CATEGORIES[s.id].en} →
              </a>
            </header>
            {s.items.map((h) => (
              <div class="border-b border-rule py-3 last:border-b-0">
                <Story h={h} kicker={false} />
              </div>
            ))}
          </section>
        ))
      }
    </div>
  </div>
</Base>
