---
import Label from "../components/Label.astro";
import Photo from "../components/Photo.astro";
import Story from "../components/Story.astro";
import Base from "../layouts/Base.astro";
import { SECTION_PHOTO, photoOfTheDay } from "../lib/archive";
import { BADGE_MIN_PUBLISHERS, CATEGORIES, SECTION_ORDER, countBy, data, editionNumber, formatDate, frontPage, sourceName, url } from "../lib/data";

const { lead, leadCoverage, also, sections, latestDay, latestCount, publishers: coverage } = frontPage(data.headlines, data.stories, 7, 4);
const leftColumn = also.slice(0, 4);
const underPhoto = also.slice(4);
const archive = photoOfTheDay(editionNumber);
const nf = new Intl.NumberFormat("en-US");

// Topic mix over the last 30 days, drawn as solid printed bars
const topicCounts = countBy(data.headlines, (h) => h.c);
const topics = SECTION_ORDER.map((id) => ({ id, n: topicCounts.get(id) ?? 0 })).filter((t) => t.n > 0);
const maxTopic = Math.max(1, ...topics.map((t) => t.n));
const sourceCounts = countBy(data.headlines, (h) => h.s);
const publishers = data.sources.map((s) => ({ ...s, recent: sourceCounts.get(s.id) ?? 0 })).sort((a, b) => b.recent - a.recent);
---

<Base title="සිංහල පුවත්" active="home">
  <h1 class="sr-only">සිංහල පුවත් සිරස්තල · Today's Sinhala news headlines</h1>

  <!-- Banner -->
  {
    lead && (
      <section class="border-b-4 border-ink pb-6 text-center" aria-label="Lead story">
        <Label si="ප්‍රධාන පුවත" en="Lead story" class="mb-2 justify-center" />
        <div class="mx-auto max-w-5xl">
          <Story h={lead} size="banner" date center kicker={false} />
        </div>
        {leadCoverage.length + 1 >= BADGE_MIN_PUBLISHERS && (
          <div class="mx-auto mt-5 max-w-3xl border-t border-ink pt-3">
            <p class="text-sm font-bold">
              මෙම පුවත ප්‍රකාශකයන් {leadCoverage.length + 1} දෙනෙක් වාර්තා කළා
              <span class="ml-1 font-sans text-xs font-normal uppercase italic tracking-[0.14em] text-ink-3">Reported by {leadCoverage.length + 1} publishers</span>
            </p>
            <ul class="mt-2 space-y-1 text-[0.95rem]">
              {leadCoverage.map((h) => (
                <li>
                  <span class="font-sans text-xs uppercase tracking-[0.12em] text-ink-3">{sourceName(h.s)}:</span>{" "}
                  <a class="headline-link font-serif font-bold" href={h.u} target="_blank" rel="noopener">{h.h}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )
  }

  <!-- Three ruled columns -->
  <div class="grid gap-y-8 pt-6 lg:grid-cols-12">
    <section class="lg:col-span-3 lg:border-r lg:border-ink lg:pr-6" aria-label="Also today">
      <Label as="h2" si="අද තවත් පුවත්" en="Also today" class="mb-3 justify-center border-b border-ink pb-1" />
      <div class="space-y-4">
        {leftColumn.map((h) => <Story h={h} size="md" center dash publishers={coverage.get(h.u)} />)}
      </div>
    </section>

    <section class="lg:col-span-6 lg:border-r lg:border-ink lg:px-6" aria-label="From the archive">
      <Label as="h2" si="අතීතයෙන්" en="From the archive" class="mb-3 justify-center border-b border-ink pb-1" />
      <Photo photo={archive} aspect="3/2" eager sizes="(min-width: 1024px) 560px, 100vw" />
      {
        underPhoto.length > 0 && (
          <div class="news-columns mt-6 border-t border-ink pt-4 sm:columns-2">
            {underPhoto.map((h) => (
              <div class="pb-4">
                <Story h={h} center dash publishers={coverage.get(h.u)} />
              </div>
            ))}
          </div>
        )
      }
    </section>

    <aside class="space-y-6 lg:col-span-3 lg:pl-6" aria-label="This edition">
      <section class="border-4 border-double border-ink p-3 text-center">
        <Label as="h2" si="මෙම කලාපය" en="This edition" class="justify-center" />
        <dl class="mt-3 grid grid-cols-3 gap-2 lg:grid-cols-1 lg:gap-3">
          <div class="flex flex-col-reverse">
            <dt class="text-sm text-ink-2">{latestDay ? formatDate(latestDay) : ""}</dt>
            <dd class="font-sans text-4xl font-bold leading-none">{nf.format(latestCount)}</dd>
          </div>
          <div class="flex flex-col-reverse">
            <dt class="text-sm text-ink-2">පසුගිය දින {data.days}</dt>
            <dd class="font-sans text-4xl font-bold leading-none">{nf.format(data.headlines.length)}</dd>
          </div>
          <div class="flex flex-col-reverse">
            <dt class="text-sm text-ink-2">මුළු දත්ත කට්ටලය</dt>
            <dd class="font-sans text-4xl font-bold leading-none">{nf.format(data.total_all_time)}</dd>
          </div>
        </dl>
      </section>

      <section>
        <Label as="h2" si="මාතෘකා" en="Topics, 30 days" class="border-b border-ink pb-1" />
        <ul class="mt-3 space-y-1.5">
          {
            topics.map((t) => (
              <li>
                <a href={url(`category/${t.id}/`)} class="group grid grid-cols-[5.5rem_1fr_2.25rem] items-center gap-3 text-sm">
                  <span class="group-hover:underline">{CATEGORIES[t.id].si}</span>
                  <span class="h-[9px] border border-ink" aria-hidden="true">
                    <span class="block h-full bg-ink" style={`width:${(100 * t.n) / maxTopic}%`} />
                  </span>
                  <span class="text-right font-sans text-ink-2">{t.n}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <Label as="h2" si="ප්‍රකාශකයන්" en="Publishers" class="border-b border-ink pb-1" />
        <ul class="mt-1 divide-y divide-rule text-sm">
          {
            publishers.map((s) => (
              <li class="flex items-baseline justify-between gap-3 py-1.5">
                <a href={url(`source/${s.id}/`)} class="font-sans hover:underline">{s.name}</a>
                <span class="font-sans text-ink-3">{s.recent}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>
  </div>

  <!-- Sections -->
  <div class="rule-masthead mt-10 pt-6">
    <div class="news-columns md:columns-2 lg:columns-3">
      {
        sections.map((s) => (
          <section class="mb-8" aria-labelledby={`sec-${s.id}`}>
            <header class="mb-3 border-y-2 border-ink py-1 text-center">
              <h2 id={`sec-${s.id}`} class="font-serif text-[1.6rem] font-extrabold leading-tight">
                <a href={url(`category/${s.id}/`)} class="hover:underline">{CATEGORIES[s.id].si}</a>
              </h2>
              <p class="font-sans text-[0.74rem] uppercase italic tracking-[0.22em] text-ink-3">{CATEGORIES[s.id].en}</p>
            </header>
            <Photo photo={SECTION_PHOTO[s.id]} aspect="16/9" caption="short" sizes="(min-width: 1024px) 340px, (min-width: 768px) 45vw, 100vw" class="mb-4" />
            <div class="space-y-4">
              {s.items.map((h) => (
                <Story h={h} kicker={false} center dash />
              ))}
            </div>
            <p class="mt-3 text-center font-sans text-sm italic">
              <a href={url(`category/${s.id}/`)} class="underline underline-offset-4">{CATEGORIES[s.id].en}: all headlines →</a>
            </p>
          </section>
        ))
      }
    </div>
  </div>
</Base>
