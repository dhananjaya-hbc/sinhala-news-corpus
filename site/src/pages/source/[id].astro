---
import HeadlineList from "../../components/HeadlineList.astro";
import Base from "../../layouts/Base.astro";
import { data, type Source } from "../../lib/data";

export function getStaticPaths() {
  return data.sources.map((source) => ({ params: { id: source.id }, props: { source } }));
}

const { source } = Astro.props as { source: Source };
const headlines = data.headlines.filter((h) => h.s === source.id);
---

<Base title={source.name} description={`Latest Sinhala news headlines from ${source.name}, linking to the original articles.`}>
  <header class="mb-6">
    <h1 class="text-2xl font-bold">{source.name}</h1>
    <p class="text-sm text-stone-500 dark:text-stone-400">
      පසුගිය දින {data.days} තුළ සිරස්තල {headlines.length} · මුළු එකතුව {source.count}
      {
        source.homepage && (
          <>
            · <a class="underline" href={source.homepage} target="_blank" rel="noopener">{new URL(source.homepage).host} ↗</a>
          </>
        )
      }
    </p>
  </header>
  <HeadlineList headlines={headlines} showSource={false} />
</Base>
