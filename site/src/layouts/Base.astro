---
import "@fontsource/abhaya-libre/500.css";
import "@fontsource/abhaya-libre/700.css";
import "@fontsource/abhaya-libre/800.css";
import "@fontsource-variable/yaldevi";
import "../styles/global.css";
import {
  CATEGORIES,
  REPO_URL,
  SECTION_ORDER,
  data,
  editionDate,
  editionNumber,
  formatLongDate,
  formatWeekday,
  url,
} from "../lib/data";

interface Props {
  title: string;
  description?: string;
  active?: string; // section id or page key to highlight in the nav
  compact?: boolean; // smaller masthead on inner pages
}

const {
  title,
  description = "Latest Sinhala news headlines from Sri Lankan publishers, arranged like a daily broadsheet. Every headline links to the original article.",
  active,
  compact = false,
} = Astro.props;
const fullTitle = title === "සිංහල පුවත්" ? "සිංහල පුවත් · The Sinhala News Corpus" : `${title} · සිංහල පුවත්`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const updated = data.generated_from ? data.generated_from.replace("T", " ").replace(/:\d\dZ$/, " UTC") : "—";
const sectionLink = "block whitespace-nowrap px-3 py-2.5 font-sans text-[0.92rem] transition-colors sm:px-4";
const utilityLink = "rounded-sm px-2 py-1 transition-colors hover:text-accent";
---

<!doctype html>
<html lang="si">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f5efe3" />
    <script is:inline>
      // Runs before the page paints, so a dark-mode reader never sees a light flash.
      // Saved choice ("light" / "dark") wins; otherwise follow the system setting.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        document.querySelector('meta[name="theme-color"]').content = dark ? "#14110e" : "#f5efe3";
      })();
    </script>
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:bg-paper focus:px-3 focus:py-2">
      Skip to content
    </a>

    <header class="mx-auto max-w-6xl px-4 sm:px-6">
      <!-- Dateline -->
      <div class="flex items-center justify-between gap-3 border-b border-rule py-2 text-[0.8rem] text-ink-2">
        <p class="flex items-center gap-2">
          <span class="hidden font-semibold text-ink sm:inline">{formatWeekday(editionDate)}</span>
          <span class="hidden sm:inline" aria-hidden="true">·</span>
          <time datetime={editionDate}>{formatLongDate(editionDate)}</time>
          <span aria-hidden="true">·</span>
          <span>අංක {editionNumber}</span>
        </p>
        <nav class="flex items-center gap-1" aria-label="Site">
          <a href={url("search/")} class:list={[utilityLink, active === "search" && "text-accent"]} aria-current={active === "search" ? "page" : undefined}>
            <svg class="inline h-4 w-4 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
            </svg>
            <span class="sr-only sm:not-sr-only">සොයන්න</span>
          </a>
          <a href={url("about/")} class:list={[utilityLink, active === "about" && "text-accent"]} aria-current={active === "about" ? "page" : undefined}>
            About
          </a>
          <button
            id="theme-toggle"
            type="button"
            class="rounded-full p-1.5 text-ink-2 transition-colors hover:bg-paper-2 hover:text-ink"
            aria-label="Switch to dark mode"
            title="Switch to dark mode"
          >
            <svg class="h-[18px] w-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
            <svg class="hidden h-[18px] w-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
        </nav>
      </div>

      <!-- Masthead -->
      <div class:list={["text-center", compact ? "py-5" : "py-7 sm:py-10"]}>
        <a href={url()} class="inline-block transition-colors hover:text-accent" aria-label="සිංහල පුවත් — home">
          <span
            class:list={[
              "block font-serif font-extrabold leading-[1.05]",
              compact ? "text-[2.6rem] sm:text-[3.6rem]" : "text-[3.4rem] sm:text-[5.6rem] lg:text-[6.8rem]",
            ]}
          >
            සිංහල පුවත්
          </span>
        </a>
        <p class:list={["font-sans uppercase tracking-[0.26em] text-ink-2 sm:tracking-[0.38em]", compact ? "mt-1 text-[0.62rem]" : "mt-3 text-[0.66rem] sm:text-xs"]}>
          The Sinhala News Corpus<span class="hidden sm:inline"> · Daily Edition</span>
        </p>
      </div>

      <!-- Sections -->
      <nav class="rule-masthead border-b border-ink" aria-label="Sections">
        <ul class="-mx-4 flex overflow-x-auto px-4 [mask-image:linear-gradient(to_right,black_85%,transparent)] [scrollbar-width:none] sm:mx-0 sm:justify-center sm:px-0 sm:[mask-image:none]">
          <li>
            <a href={url()} class:list={[sectionLink, active === "home" ? "font-semibold text-accent" : "text-ink hover:text-accent"]} aria-current={active === "home" ? "page" : undefined}>
              මුල් පිටුව
            </a>
          </li>
          {
            SECTION_ORDER.map((id) => (
              <li class="border-l border-rule">
                <a
                  href={url(`category/${id}/`)}
                  class:list={[sectionLink, active === id ? "font-semibold text-accent" : "text-ink hover:text-accent"]}
                  aria-current={active === id ? "page" : undefined}
                >
                  {CATEGORIES[id].si}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
      <slot />
    </main>

    <footer class="mt-8 border-t-[3px] border-double border-ink">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm text-ink-2 sm:grid-cols-3 sm:px-6">
        <div>
          <p class="font-serif text-3xl font-extrabold text-ink">සිංහල පුවත්</p>
          <p class="mt-2">
            සිංහල භාෂා තාක්ෂණය සඳහා විවෘත පුවත් සිරස්තල දත්ත කට්ටලයක්.
            <span class="block text-ink-3">An open dataset of Sinhala news headlines for language research.</span>
          </p>
        </div>
        <div>
          <p class="font-semibold text-ink">ප්‍රකාශන අයිතිය <span class="ml-1 text-[0.66rem] font-medium uppercase tracking-[0.22em] text-ink-3">Copyright</span></p>
          <p class="mt-2">
            සිරස්තල එක් එක් ප්‍රකාශකයාට අයත් වේ.
            <span class="block text-ink-3">
              Headlines belong to their publishers and each links to the original article. No article text or images are copied.
            </span>
          </p>
        </div>
        <div>
          <p class="font-semibold text-ink">දත්ත <span class="ml-1 text-[0.66rem] font-medium uppercase tracking-[0.22em] text-ink-3">Data</span></p>
          <ul class="mt-2 space-y-1">
            <li><a class="underline decoration-rule underline-offset-4 hover:text-accent" href={REPO_URL}>Source code on GitHub</a></li>
            <li>
              Data <a class="underline decoration-rule underline-offset-4 hover:text-accent" href={`${REPO_URL}/blob/main/DATA_LICENSE.md`}>CC BY 4.0</a> ·
              Code <a class="underline decoration-rule underline-offset-4 hover:text-accent" href={`${REPO_URL}/blob/main/LICENSE`}>MIT</a>
            </li>
            <li class="text-ink-3">Last collected {updated}</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-rule">
        <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-ink-3 sm:px-6">
          Set in Abhaya Libre &amp; Yaldevi, Sinhala typefaces by Mooniak · අංක {editionNumber}
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById("theme-toggle") as HTMLButtonElement;
      const themeColor = document.querySelector('meta[name="theme-color"]') as HTMLMetaElement;
      const system = matchMedia("(prefers-color-scheme: dark)");

      function savedTheme(): string | null {
        try {
          return localStorage.getItem("theme");
        } catch {
          return null; // storage blocked (private mode): the toggle still works for this page
        }
      }

      function apply(dark: boolean) {
        root.classList.toggle("dark", dark);
        themeColor.content = dark ? "#14110e" : "#f5efe3";
        const label = dark ? "Switch to light mode" : "Switch to dark mode";
        toggle.setAttribute("aria-label", label);
        toggle.title = label;
      }

      apply(root.classList.contains("dark"));

      toggle.addEventListener("click", () => {
        const dark = !root.classList.contains("dark");
        apply(dark);
        try {
          localStorage.setItem("theme", dark ? "dark" : "light");
        } catch {}
      });

      // Until the reader picks a theme, keep following the system setting.
      system.addEventListener("change", (event) => {
        if (!savedTheme()) apply(event.matches);
      });
    </script>
  </body>
</html>
