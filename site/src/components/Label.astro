---
// Section label: Sinhala text plus a small English gloss in small capitals.
// Letter-spacing is applied to the English only: spacing out Sinhala
// letters can break conjunct shaping (ශ්‍රී, ප්‍ර).
interface Props {
  si: string;
  en?: string;
  as?: "p" | "h2" | "h3";
  class?: string;
}

const { si, en, as: Tag = "p", class: className } = Astro.props;
---

<Tag class:list={["flex flex-wrap items-baseline gap-x-2 text-[0.98rem] font-bold text-ink", className]}>
  <span>{si}</span>
  {en && <span class="font-sans text-[0.74rem] font-normal uppercase italic tracking-[0.18em] text-ink-3">{en}</span>}
</Tag>
