---
// Section label: Sinhala text plus a small English gloss.
// Letter-spacing is applied to the English only: spacing out Sinhala
// letters can break conjunct shaping (ශ්‍රී, ප්‍ර).
interface Props {
  si: string;
  en?: string;
  as?: "p" | "h2" | "h3";
  class?: string;
}

const { si, en, as: Tag = "p", class: className } = Astro.props;
---

<Tag class:list={["flex flex-wrap items-baseline gap-x-2 font-sans text-[0.82rem] font-semibold text-accent", className]}>
  <span>{si}</span>
  {en && <span class="text-[0.66rem] font-medium uppercase tracking-[0.22em] text-ink-3">{en}</span>}
</Tag>
