---
import { CATEGORIES, formatDate, groupByDate, sourceName, url, type Headline } from "../lib/data";

interface Props {
  headlines: Headline[];
  showCategory?: boolean;
  showSource?: boolean;
}

const { headlines, showCategory = true, showSource = true } = Astro.props;
const groups = groupByDate(headlines);
---

{
  groups.length === 0 ? (
    <p class="rounded-lg border border-dashed border-stone-300 p-8 text-center text-stone-500 dark:border-stone-700">
      මෙම කාණ්ඩයේ මෑත සිරස්තල නැත. · No recent headlines here yet.
    </p>
  ) : (
    groups.map(([day, items]) => (
      <section class="mb-8" aria-labelledby={`d-${day}`}>
        <h2 id={`d-${day}`} class="sticky top-0 z-[1] -mx-4 mb-2 bg-stone-50/95 px-4 py-2 text-sm font-semibold text-stone-500 backdrop-blur dark:bg-stone-950/95 dark:text-stone-400">
          <time datetime={day}>{formatDate(day)}</time>
        </h2>
        <ul class="divide-y divide-stone-200 overflow-hidden rounded-xl border border-stone-200 bg-white dark:divide-stone-800 dark:border-stone-800 dark:bg-stone-900">
          {items.map((h) => (
            <li class="px-4 py-3">
              <a href={h.u} target="_blank" rel="noopener" class="text-[1.05rem] font-semibold leading-relaxed hover:text-sky-700 hover:underline dark:hover:text-sky-300">
                {h.h}
              </a>
              <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-stone-500 dark:text-stone-400">
                {showCategory && (
                  <a href={url(`category/${h.c}/`)} class:list={["rounded-full px-2 py-0.5 font-medium", CATEGORIES[h.c].chip]}>
                    {CATEGORIES[h.c].si}
                  </a>
                )}
                {showSource && (
                  <a href={url(`source/${h.s}/`)} class="hover:underline">
                    {sourceName(h.s)}
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  )
}
