---
import type { Headline } from "../lib/data";
import Story from "./Story.astro";

interface Props {
  headlines: Headline[];
  showCategory?: boolean;
  showSource?: boolean;
}

const { headlines, showCategory = true, showSource = true } = Astro.props;
---

{
  headlines.length === 0 ? (
    <p class="border-y-2 border-ink py-12 text-center font-serif text-xl text-ink-2">
      මෙම අංශයේ මෑත සිරස්තල නැත.
      <span class="mt-1 block font-sans text-sm italic text-ink-3">No recent headlines in this section yet.</span>
    </p>
  ) : (
    <h2 class="sr-only">සිරස්තල · Headlines</h2>
    <div class="news-columns md:columns-2 lg:columns-3">
      {headlines.map((h) => (
        <div class="pb-4">
          <Story h={h} kicker={showCategory} source={showSource} date center dash />
        </div>
      ))}
    </div>
  )
}
