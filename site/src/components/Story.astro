---
import { CATEGORIES, formatLongDate, sourceName, url, type Headline } from "../lib/data";

interface Props {
  h: Headline;
  size?: "banner" | "lead" | "md" | "sm";
  kicker?: boolean; // show the section above the headline
  source?: boolean;
  date?: boolean;
  center?: boolean;
  dash?: boolean; // short centred rule after the story
  publishers?: number; // how many publishers covered this story (shown when 2+)
}

const { h, size = "sm", kicker = true, source = true, date = false, center = false, dash = false, publishers = 0 } = Astro.props;
const headlineSize = {
  banner: "text-[2.3rem] leading-[1.22] font-extrabold sm:text-[3.3rem] lg:text-[3.9rem]",
  lead: "text-[1.8rem] leading-[1.3] font-extrabold sm:text-[2.2rem]",
  md: "text-[1.42rem] leading-[1.4] font-bold",
  sm: "text-[1.2rem] leading-[1.45] font-bold",
}[size];
---

<article class:list={[center && "text-center", dash && "story-dash"]}>
  {
    kicker && (
      <a href={url(`category/${h.c}/`)} class="mb-0.5 inline-block text-[0.95rem] font-bold text-ink-2 hover:underline">
        {CATEGORIES[h.c].si}
      </a>
    )
  }
  <h3 class:list={["font-serif text-ink", headlineSize]}>
    <a class="headline-link" href={h.u} target="_blank" rel="noopener">{h.h}</a>
  </h3>
  {
    (source || date || publishers > 1) && (
      <p
        class:list={[
          "flex flex-wrap items-center gap-x-2 text-ink-3",
          center && "justify-center",
          size === "banner" || size === "lead" ? "mt-3 text-[0.95rem]" : "mt-1 text-[0.85rem]",
        ]}
      >
        {source && (
          <a href={url(`source/${h.s}/`)} class="font-sans uppercase tracking-[0.12em] hover:text-ink">
            {sourceName(h.s)}
          </a>
        )}
        {source && date && <span aria-hidden="true">·</span>}
        {date && <time datetime={h.d}>{formatLongDate(h.d)}</time>}
        {publishers > 1 && (
          <span class="border border-ink px-1.5 leading-snug text-ink" title={`Reported by ${publishers} publishers`}>
            ප්‍රකාශකයන් {publishers}
          </span>
        )}
      </p>
    )
  }
</article>
